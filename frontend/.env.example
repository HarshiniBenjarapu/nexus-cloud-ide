# ─────────────────────────────────────────────────────────────────────────────
# Nexus Cloud IDE — Frontend Environment Variables (TEMPLATE)
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser bundle,
# so never put secrets in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the Nexus backend API, including the /api prefix.
# Falls back to http://localhost:5000/api when unset.
VITE_API_URL=http://localhost:5000/api
