# ─────────────────────────────────────────────────────────────────────────────
# Nexus Cloud IDE — Backend Environment Variables (TEMPLATE)
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed (SRS 8.11 / 10.3).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ─── Authentication ──────────────────────────────────────────────────────────
# Use a long, random, high-entropy value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Origin of the frontend dev server (Vite default is 5173)
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Not yet consumed by the codebase — reserved for later milestones (SRS 10.3).
# Leave unset until the corresponding module is implemented.
# ─────────────────────────────────────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# ANTHROPIC_API_KEY=
# VERCEL_TOKEN=
